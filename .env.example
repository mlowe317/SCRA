# Copy to .env and fill in. Never commit .env.

# SQLite for local dev. For PostgreSQL, set provider = "postgresql" in
# prisma/schema.prisma and use e.g. postgresql://user:pass@host:5432/scra
DATABASE_URL="file:./dev.db"

# 32 random bytes as 64 hex chars. Generate with: npm run gen:key
# Losing or changing this key makes every stored SSN unreadable.
ENCRYPTION_KEY=""
